<resources>
    <style name="Theme.Quoter" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/black</item>
        <item name="android:fontFamily">@font/main_regular</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/onPrimary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.Quoter</item>
    </style>
    <style name="QuoterTimePickerLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/black</item>
    </style>
    <style name="QuoterTimePickerDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/white</item>
    </style>
</resources>
